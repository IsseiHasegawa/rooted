# Copy to .env and fill in the keys. Never commit .env.
# Seeds: run .venv/bin/python scripts/ensure_seeds.py to fill any missing ones. A seed fixes an
# agent's address, so the backup laptop must use the same .env.

ASI_ONE_API_KEY=
AGENTVERSE_API_KEY=
GOOGLE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

ORCHESTRATOR_SEED=
RISK_SEED=
VISUALIZER_SEED=
FUNDING_SEED=
CONTRACTOR_JUNIPER_SEED=
CONTRACTOR_MESA_SEED=
CONTRACTOR_ARBOR_SEED=

# Comma-separated contractor ids that stop answering (failover demo), e.g. mesa
CONTRACTOR_OFFLINE=
DEMO_MODE=
STRIPE_SUCCESS_URL=
